{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "helpscout",
  "version": "1.0.0",
  "description": "Search Help Scout conversations and customers, summarize support threads, and report on volume, response times and happiness.",
  "author": {
    "name": "Flexkit"
  },
  "homepage": "https://github.com/flexkit-io/plugins/tree/main/helpscout",
  "repository": "https://github.com/flexkit-io/plugins",
  "license": "MIT",
  "keywords": [
    "helpscout",
    "help scout",
    "customer support",
    "helpdesk",
    "flexkit"
  ],
  "extensions": {
    "io.flexkit": {
      "schemaVersion": 1,
      "displayName": "Help Scout",
      "logo": "./assets/logo.svg",
      "category": "support",
      "supportedScopes": [
        "project",
        "personal"
      ],
      "requiredInputs": [],
      "capabilities": {
        "agentTools": true,
        "automationDelivery": false
      },
      "auth": {
        "type": "mcp-oauth",
        "provider": "mcp",
        "credentialGroup": "helpscout",
        "requiredScopes": [
          "helpscout"
        ],
        "mcpServers": [
          "helpscout"
        ]
      }
    }
  }
}
