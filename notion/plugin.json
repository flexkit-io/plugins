{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "notion",
  "version": "1.0.0",
  "description": "Search and work with your Notion workspace.",
  "author": {
    "name": "Flexkit"
  },
  "homepage": "https://github.com/flexkit-io/plugins/tree/main/notion",
  "repository": "https://github.com/flexkit-io/plugins",
  "license": "MIT",
  "keywords": [
    "notion",
    "flexkit"
  ],
  "extensions": {
    "io.flexkit": {
      "schemaVersion": 1,
      "displayName": "Notion",
      "logo": "./assets/logo.svg",
      "category": "productivity",
      "supportedScopes": [
        "project",
        "personal"
      ],
      "requiredInputs": [],
      "capabilities": {
        "agentTools": true,
        "automationDelivery": false
      },
      "auth": {
        "type": "mcp-oauth",
        "provider": "notion",
        "credentialGroup": "notion",
        "requiredScopes": [],
        "mcpServers": [
          "notion"
        ]
      }
    }
  }
}
