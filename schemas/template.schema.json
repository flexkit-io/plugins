{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flexkit.io/schemas/template.schema.json",
  "title": "Flexkit template manifest (templates/<name>/template.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "kind", "displayName", "description", "category", "version", "howItWorks", "plugins", "data", "parameters"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64 },
    "kind": { "type": "string", "enum": ["automation", "skill"] },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "minLength": 1, "maxLength": 300 },
    "category": {
      "type": "string",
      "enum": ["catalog", "orders-customers", "marketing", "reporting", "data-quality", "team-ops"]
    },
    "icon": {
      "description": "The avatar's Lucide icon (lucide.dev/icons). Studio draws only these; add one there before adding it here.",
      "type": "string",
      "enum": ["bell", "book-open", "calculator", "calendar-clock", "chart-column", "clipboard-check", "database", "eye-off", "file-text", "globe", "hourglass", "inbox", "languages", "list-checks", "mail", "megaphone", "message-square", "newspaper", "package-minus", "pen-line", "receipt", "refresh-cw", "repeat", "scale", "scroll-text", "search-check", "send", "shield-check", "shopping-cart", "sigma", "siren", "smile", "sparkles", "star", "tag", "truck", "users", "webhook", "zap"]
    },
    "color": {
      "description": "The avatar's color from Studio's palette. Give templates that sit together different colors.",
      "type": "string",
      "enum": ["violet", "blue", "sky", "teal", "emerald", "amber", "orange", "rose"]
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "howItWorks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "text"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 40 },
          "text": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "required", "reason"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64 },
          "required": { "type": "boolean" },
          "reason": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "description", "type", "required"],
        "properties": {
          "key": { "$ref": "#/$defs/key" },
          "description": { "type": "string", "minLength": 1, "maxLength": 300 },
          "entityHint": { "type": "string", "minLength": 1, "maxLength": 64 },
          "fieldHint": { "type": "string", "minLength": 1, "maxLength": 64 },
          "type": { "type": "string", "enum": ["string", "number", "boolean", "date", "reference", "any"] },
          "required": { "type": "boolean" }
        }
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "type"],
        "properties": {
          "key": { "$ref": "#/$defs/key" },
          "label": { "type": "string", "minLength": 1, "maxLength": 80 },
          "type": { "type": "string", "enum": ["string", "number", "boolean", "cron", "timezone", "channel", "select"] },
          "default": { "type": ["string", "number", "boolean"], "maxLength": 500 },
          "description": { "type": "string", "maxLength": 300 },
          "options": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 80 }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "type": { "const": "channel" } } },
            "else": { "required": ["default"] }
          },
          {
            "if": { "properties": { "type": { "const": "select" } } },
            "then": { "required": ["options"] },
            "else": { "not": { "required": ["options"] } }
          }
        ]
      }
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "mutationPolicy", "notifyRule", "recommendedSkills"],
      "properties": {
        "trigger": { "$ref": "#/$defs/triggerHint" },
        "mutationPolicy": { "type": "string", "enum": ["require_approval", "auto_approve"] },
        "notifyRule": { "type": "string", "enum": ["always", "when_flagged", "failures", "never"] },
        "recommendedSkills": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64 }
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loadMode"],
      "properties": {
        "loadMode": { "type": "string", "enum": ["always", "on_demand"] }
      }
    },
    "keywords": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 40 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "automation" } }, "required": ["kind"] },
      "then": { "required": ["automation"], "not": { "required": ["skill"] } }
    },
    {
      "if": { "properties": { "kind": { "const": "skill" } }, "required": ["kind"] },
      "then": { "required": ["skill"], "not": { "required": ["automation"] } }
    }
  ],
  "$defs": {
    "key": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$", "maxLength": 64 },
    "triggerHint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["schedule", "webhook", "entity", "job", "poll"] },
        "cron": { "type": "string", "minLength": 1, "maxLength": 120 },
        "timezone": { "type": "string", "minLength": 1, "maxLength": 64 },
        "events": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["create", "update", "delete"] }
        },
        "entityHint": { "type": "string", "minLength": 1, "maxLength": 64 },
        "job": { "type": "string", "enum": ["automation_run", "bulk_action", "schema_deploy"] },
        "outcome": { "type": "string", "enum": ["any", "failed", "succeeded"] },
        "automationId": { "type": ["string", "null"] },
        "intervalMinutes": { "type": "integer", "minimum": 5, "maximum": 1440 }
      }
    }
  }
}
