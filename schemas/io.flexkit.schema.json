{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "logo": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "supportedScopes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "project",
          "personal"
        ]
      }
    },
    "auth": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "oauth2",
                "mcp-oauth",
                "none"
              ]
            },
            "provider": {
              "type": "string",
              "enum": [
                "google",
                "slack",
                "teams",
                "notion",
                "stripe",
                "mcp"
              ],
              "description": "mcp: any MCP server that follows the MCP authorization spec, through a reviewed authorization server"
            },
            "credentialGroup": {
              "type": "string",
              "minLength": 1
            },
            "requiredScopes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "mcpServers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "type",
            "provider",
            "credentialGroup",
            "requiredScopes"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "A token the user pastes once into Studio's connect form. The platform stores it encrypted and sends it only to the plugin's reviewed MCP endpoint; the agent never sees it.",
          "properties": {
            "type": {
              "const": "api-token"
            },
            "credentialGroup": {
              "type": "string",
              "minLength": 1
            },
            "mcpServers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "token": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "description": "What the provider calls it, e.g. \"Tinybird token\"."
                },
                "helpUrl": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://",
                  "description": "Where to create one, and which permissions to give it."
                },
                "placeholder": {
                  "type": "string",
                  "maxLength": 120
                },
                "pattern": {
                  "type": "string",
                  "maxLength": 200,
                  "description": "Regular expression (Unicode mode) a valid token matches. Studio also uses it to stop a token from being pasted into chat."
                },
                "header": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9-]{1,64}$",
                  "description": "Header the token is sent in. Default: Authorization: Bearer <token>."
                }
              },
              "required": [
                "label"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "credentialGroup",
            "token"
          ],
          "additionalProperties": false
        }
      ]
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "agentTools": {
          "type": "boolean"
        },
        "automationDelivery": {
          "type": "boolean"
        }
      },
      "required": [
        "agentTools",
        "automationDelivery"
      ],
      "additionalProperties": false
    },
    "delivery": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string",
          "enum": [
            "slack",
            "teams"
          ]
        },
        "channelPicker": {
          "type": "boolean"
        }
      },
      "required": [
        "adapter",
        "channelPicker"
      ],
      "additionalProperties": false
    },
    "availability": {
      "type": "string",
      "const": "preview"
    },
    "upstream": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "path": {
          "type": "string"
        },
        "sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      },
      "required": [
        "repository",
        "path",
        "sha"
      ],
      "additionalProperties": false
    },
    "requiredInputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "const": "channel-multi-select"
          },
          "requiredWhen": {
            "type": "string",
            "const": "delivery-enabled"
          },
          "optionsSource": {
            "type": "string",
            "const": "connection.channels"
          },
          "target": {
            "type": "string",
            "const": "toolConfigs.channels"
          }
        },
        "required": [
          "key",
          "type",
          "requiredWhen",
          "optionsSource",
          "target"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "displayName",
    "category",
    "supportedScopes",
    "auth",
    "capabilities",
    "requiredInputs"
  ],
  "additionalProperties": false
}
